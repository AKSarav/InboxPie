{
  "name": "inboxpie",
  "productName": "InboxPie",
  "version": "0.1.0",
  "description": "Visualize and clean your inbox. Private, local, open source.",
  "main": "./out/main/index.js",
  "author": "AKSarav",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "@langchain/anthropic": "^1.4.0",
    "@langchain/core": "^1.1.48",
    "@langchain/google-genai": "^2.1.31",
    "@langchain/langgraph": "^1.3.6",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.4.7",
    "@xenova/transformers": "^2.17.2",
    "echarts": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "graphology": "^0.26.0",
    "sigma": "^2.4.0",
    "typescript": "^5.8.2"
  },
  "build": {
    "appId": "com.inboxpie.app",
    "productName": "InboxPie",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "scripts/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "src/renderer/assets/icon.png",
        "to": "renderer/assets/icon.png"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "src/renderer/assets/icon.png"
    }
  }
}
